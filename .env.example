#lerobot/.env

# Set the ports and IDs for the follower and leader arms.
FOLLOWER_PORT=/dev/tty.usbmodem5B141127181
LEADER_PORT=/dev/tty.usbmodem5B140319231
FOLLOWER_ID=follower_arm
LEADER_ID=leader_arm

# Optional: set an HF org/user owner for dataset uploads.
# If omitted, scripts/record.sh uploads to the currently logged-in HF user.
HF_DATASET_OWNER=rl26-world-models

# Optional: control HF dataset visibility on upload.
# Defaults to private if omitted. Set false to upload public datasets.
HF_DATASET_PRIVATE=true

# Optional Hub revision when syncing for `record.sh --resume` (default: LeRobot v3.0 tag).
# HF_DATASET_REVISION=v3.0